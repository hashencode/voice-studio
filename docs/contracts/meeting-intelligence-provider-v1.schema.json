{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice2text.example/contracts/meeting-intelligence-provider-v1.schema.json",
  "title": "Meeting Intelligence Provider Protocol v1",
  "type": "object",
  "required": ["schemaVersion", "messageType", "protocolVersion", "sessionId"],
  "properties": {
    "schemaVersion": {"const": "meeting_intelligence_provider/v1"},
    "messageType": {
      "enum": [
        "pairingOffer",
        "pairingAccept",
        "jobRequest",
        "jobProgress",
        "jobCancel",
        "jobResult"
      ]
    },
    "protocolVersion": {"const": 1},
    "sessionId": {"$ref": "#/$defs/identifier"},
    "endpoint": {
      "type": "string",
      "pattern": "^wss://[^/?#@]+(?::[0-9]+)?/[^?#]*$",
      "maxLength": 2048
    },
    "serverPublicKey": {"$ref": "#/$defs/base64url"},
    "publicKeyFingerprint": {"$ref": "#/$defs/sha256"},
    "challenge": {"$ref": "#/$defs/base64url"},
    "challengeProof": {"$ref": "#/$defs/base64url"},
    "issuedAtMs": {"type": "integer", "minimum": 0},
    "expiresAtMs": {"type": "integer", "minimum": 0},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "meeting_intelligence.generate.v1",
          "meeting_intelligence.progress.v1",
          "meeting_intelligence.cancel.v1",
          "meeting_intelligence.retry.v1"
        ]
      }
    },
    "providerId": {"$ref": "#/$defs/nonEmpty"},
    "modelId": {"$ref": "#/$defs/nonEmpty"},
    "processingLocation": {"const": "pairedPc"},
    "jobId": {"$ref": "#/$defs/identifier"},
    "idempotencyKey": {"$ref": "#/$defs/identifier"},
    "inputHash": {"$ref": "#/$defs/sha256"},
    "input": {"$ref": "#/$defs/meetingInput"},
    "progressPercent": {"type": "integer", "minimum": 0, "maximum": 100},
    "stage": {
      "enum": ["queued", "processing", "reducing", "validating", "completed"]
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 200},
    "output": {"$ref": "#/$defs/meetingOutput"}
  },
  "allOf": [
    {
      "if": {"properties": {"messageType": {"const": "pairingOffer"}}},
      "then": {
        "required": [
          "endpoint",
          "serverPublicKey",
          "publicKeyFingerprint",
          "challenge",
          "issuedAtMs",
          "expiresAtMs",
          "capabilities",
          "providerId",
          "modelId",
          "processingLocation"
        ]
      }
    },
    {
      "if": {"properties": {"messageType": {"const": "pairingAccept"}}},
      "then": {
        "required": [
          "challenge",
          "challengeProof",
          "capabilities",
          "processingLocation"
        ]
      }
    },
    {
      "if": {"properties": {"messageType": {"const": "jobRequest"}}},
      "then": {
        "required": [
          "jobId",
          "idempotencyKey",
          "inputHash",
          "providerId",
          "modelId",
          "processingLocation",
          "input"
        ]
      }
    },
    {
      "if": {"properties": {"messageType": {"const": "jobProgress"}}},
      "then": {
        "required": [
          "jobId",
          "idempotencyKey",
          "inputHash",
          "progressPercent",
          "stage"
        ]
      }
    },
    {
      "if": {"properties": {"messageType": {"const": "jobCancel"}}},
      "then": {"required": ["jobId", "idempotencyKey", "inputHash", "reason"]}
    },
    {
      "if": {"properties": {"messageType": {"const": "jobResult"}}},
      "then": {
        "required": [
          "jobId",
          "idempotencyKey",
          "inputHash",
          "providerId",
          "modelId",
          "processingLocation",
          "output"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "nonEmpty": {"type": "string", "minLength": 1, "maxLength": 200},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,256}$"
    },
    "segment": {
      "type": "object",
      "required": ["segment_id", "start_ms", "end_ms", "text"],
      "properties": {
        "segment_id": {"type": "integer", "minimum": 1},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "speaker_label": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "additionalProperties": false
    },
    "meetingInput": {
      "type": "object",
      "required": [
        "schema_version",
        "template_id",
        "input_start_ms",
        "input_end_ms",
        "segments"
      ],
      "properties": {
        "schema_version": {"const": "meeting_intelligence_input/v1"},
        "template_id": {
          "enum": [
            "general",
            "weekly",
            "review",
            "interview",
            "sales",
            "retrospective",
            "oneOnOne"
          ]
        },
        "input_start_ms": {"type": "integer", "minimum": 0},
        "input_end_ms": {"type": "integer", "minimum": 1},
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/segment"}
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["segment_id", "start_ms", "end_ms"],
      "properties": {
        "segment_id": {"type": "integer", "minimum": 1},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "insight": {
      "type": "object",
      "required": [
        "kind",
        "body",
        "evidence",
        "action_owner",
        "action_due_at_ms",
        "resolution_state",
        "topic_start_ms",
        "topic_end_ms",
        "sort_order"
      ],
      "properties": {
        "kind": {
          "enum": [
            "title",
            "summary",
            "summaryKeyPoint",
            "summaryDetailed",
            "topic",
            "decision",
            "action",
            "risk",
            "unresolved"
          ]
        },
        "body": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "action_owner": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200
        },
        "action_due_at_ms": {"type": ["integer", "null"]},
        "resolution_state": {"enum": ["notApplicable", "open", "resolved"]},
        "topic_start_ms": {"type": ["integer", "null"]},
        "topic_end_ms": {"type": ["integer", "null"]},
        "sort_order": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "meetingOutput": {
      "type": "object",
      "required": ["schema_version", "meeting_type", "suggested_title", "items"],
      "properties": {
        "schema_version": {"const": "meeting_intelligence_output/v1"},
        "meeting_type": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 100
        },
        "suggested_title": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200
        },
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {"$ref": "#/$defs/insight"}
        }
      },
      "additionalProperties": false
    }
  }
}
