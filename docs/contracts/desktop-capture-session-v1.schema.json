{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice2text.local/contracts/desktop-capture-session-v1.schema.json",
  "title": "Desktop Capture Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sessionId",
    "state",
    "captureTimelineMs",
    "createdAtMs",
    "updatedAtMs",
    "tracks",
    "chunks",
    "events",
    "spool"
  ],
  "properties": {
    "schema": {
      "const": "desktop-capture-session/v1"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^session-[a-zA-Z0-9-]{12,120}$"
    },
    "captureMode": {
      "enum": [
        "dual_track",
        "microphone_only"
      ]
    },
    "state": {
      "enum": [
        "preparing",
        "recording",
        "paused",
        "finalizing",
        "completed",
        "recoverable",
        "partial_capture",
        "failed"
      ]
    },
    "captureTimelineMs": {
      "type": "integer",
      "minimum": 0
    },
    "createdAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "chunks": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "spool": {
      "$ref": "#/$defs/spool"
    },
    "recordingId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "recordingSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "healthy",
        "sampleRate",
        "channels",
        "format"
      ],
      "properties": {
        "kind": {
          "enum": [
            "system_audio",
            "microphone"
          ]
        },
        "healthy": {
          "type": "boolean"
        },
        "sampleRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "format": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track",
        "sequence",
        "startMs",
        "endMs",
        "relativePath",
        "bytes",
        "sha256",
        "finalized"
      ],
      "properties": {
        "track": {
          "enum": [
            "system_audio",
            "microphone"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        },
        "relativePath": {
          "type": "string",
          "pattern": "^(system|microphone)/chunk-[0-9]{6}\\.(caf|wav)$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "finalized": {
          "const": true
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "monotonicMs",
        "kind",
        "track",
        "reason"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "monotonicMs": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "device_changed",
            "permission_revoked",
            "gap_started",
            "gap_ended",
            "format_changed",
            "disk_low",
            "encoder_failed"
          ]
        },
        "track": {
          "enum": [
            "system_audio",
            "microphone",
            "all"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "spool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "format",
        "sampleRate",
        "channels",
        "frameDurationMs",
        "disposable"
      ],
      "properties": {
        "relativePath": {
          "const": "caption/live-caption.pcmspool"
        },
        "format": {
          "const": "s16le"
        },
        "sampleRate": {
          "const": 16000
        },
        "channels": {
          "const": 1
        },
        "frameDurationMs": {
          "const": 100
        },
        "disposable": {
          "const": true
        }
      }
    }
  }
}
