  "semantics": {
    "library": {
      "query": "trimmed case-insensitive substring",
      "limit": { "minimum": 1, "maximum": 500 },
      "ordering": "updated-descending then meeting-id-descending"
    },
    "authority": {
      "selection": "only a complete active result publication may become an active formal generation",
      "manualText": "stable segment manual text and review state survive a later processing publication",
      "manualSpeaker": "stable speaker names, merges, and segment assignments survive a later processing publication",
      "provenance": "machine text and formal generation identity remain distinct from manual values",
      "undoRedo": "text revision history is durable; a new edit invalidates the redo branch"
    },
    "speakers": {
      "states": ["assigned", "overlap", "unknown"],
      "manualSourceWins": true
    },
    "playback": {
      "privilegeOwner": "electron-main",
      "rendererContract": "opaque meeting id and allowlisted action only",
      "speed": { "minimum": 0.5, "maximum": 2.0 },
      "seek": "clamped to zero and meeting duration"
    },
    "export": {
      "formats": ["txt", "md", "vtt", "srt", "json"],
      "source": "selected active generation including reviewed manual authority",
      "destinationOwner": "electron-main",
      "safeFilename": "path separators, colon, and control characters replaced; empty base falls back to meeting"
    }
  },
  "fixtures": {
    "mixedSpeakerMeeting": {
      "displayName": "项目周会",
      "durationMs": 6000,
      "segments": [
        {
          "sequenceId": 0,
          "startMs": 0,
          "endMs": 1500,
          "text": "确认下周发布。",
