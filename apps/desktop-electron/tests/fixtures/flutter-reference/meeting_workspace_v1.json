        },
        {
          "sequenceId": 2,
          "startMs": 3000,
          "endMs": 5000,
          "text": "好的。",
          "speakerState": "overlap",
          "speakerKey": null
        }
      ]
    },
    "largeTranscript": {
      "segmentCount": 3001,
      "targetSequenceId": 2999,
      "targetText": "唯一检索目标",
      "sampleCount": 20,
      "openP95MaximumMs": 2000,
      "searchP95MaximumMs": 200
    }
  },
  "acceptance": [
    "restart preserves active generation, manual revisions, speakers, and media-time mapping",
    "processing retry cannot overwrite manual transcript or speaker authority",
    "empty, partial, overlap, unknown-speaker, and 3001-segment workspaces remain usable",
    "all review actions have keyboard and visible semantic status",
    "Renderer receives neither media paths nor export destinations"
  ],
