{
  "name": "voice2text-desktop",
  "productName": "Voice2Text",
  "version": "0.1.0",
  "description": "Local-first Voice2Text desktop workstation",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "build": "vite build",
    "package": "bun run resources:worker && electron-forge package",
    "make": "bun run resources:worker && electron-forge make",
    "resources:worker": "bash scripts/build-worker-resources.sh",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run check:boundaries && bun run check:lifecycle",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check:boundaries": "bun scripts/check-renderer-boundaries.ts",
    "check:lifecycle": "bun scripts/check-bun-lifecycle.ts",
    "smoke:package": "bun scripts/smoke-packaged-macos.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "trustedDependencies": [
    "electron"
  ]
}
